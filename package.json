    "prestart": "node scripts/patch-privy-7702.mjs",
    "start": "next start --port 3001",
    "prestart:3000": "node scripts/patch-privy-7702.mjs",
    "start:3000": "next start",
    "start:all": "concurrently -c \"cyan,magenta\" -n \"SITE,BOT\" \"npm run start\" \"npm run bot:supervisor\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test:logic": "tsx scripts/test-business-logic.mjs",
    "health:prod": "node scripts/check-production-health.mjs",
    "typecheck": "next typegen && tsc --noEmit --incremental false",
    "smoke:http": "node scripts/smoke-http.mjs",
    "smoke:browser": "node scripts/smoke-browser.mjs",
    "check": "node scripts/check-local.mjs",
    "postinstall": "node scripts/patch-privy-7702.mjs",
    "patch:privy-7702": "node scripts/patch-privy-7702.mjs"
  },
  "dependencies": {
    "@base-org/account": "2.5.6",
