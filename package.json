    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.27",
    "concurrently": "^9.2.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "open-cli": "^9.0.0",
    "playwright-core": "^1.58.2",
    "postcss": "8.5.14",
    "solc": "^0.8.35",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.20.5",
    "typescript": "^5"
  },
  "overrides": {
    "axios": "1.16.0",
    "bn.js": "5.2.3",
    "hono": "4.12.18",
