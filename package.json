    "@privy-io/wagmi": "^4.0.6",
    "@tanstack/react-query": "^5.90.21",
    "@wagmi/core": "3.4.8",
    "accounts": "^0.8.1",
    "dotenv": "^17.3.1",
    "ethers": "^6.16.0",
    "next": "16.2.6",
    "ox": "0.14.20",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "viem": "2.48.8",
    "wagmi": "^3.6.9"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
