# Local SQLite database file path on the server.
# If omitted, the app will use ./data/lore.sqlite
# LORE_DB_PATH=/var/lib/lore/lore.sqlite
# Trust forwarded client IP headers for rate limits only behind a proxy that strips spoofed headers.
# TRUST_PROXY_HEADERS=0
# TRUST_PROXY_SECRET=replace-with-at-least-32-random-characters
# Local/CI production smoke only. Deployed testnet, staging, and mainnet hosts must keep this disabled.
# ALLOW_WEAK_RATE_LIMIT_IDENTITY=0
# Opt-in for public Sepolia staging/canary hosts; local dev should leave it disabled.
# LORE_PREMAINNET_RUNTIME_STRICT=0
# Required when LORE_PREMAINNET_RUNTIME_STRICT=1 on a public staging/canary host.
# WEB_REPLICA_COUNT=2
# UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
# UPSTASH_REDIS_REST_TOKEN=replace-with-server-only-standard-token
# RATE_LIMIT_EXTERNAL_FAIL_CLOSED=1

# Network selection
# Keep omitted for the current Sepolia testnet deploy.
# LINEA_NETWORK=mainnet
# NEXT_PUBLIC_LINEA_NETWORK=mainnet
# LINEA_CHAIN_ID=59144
# NEXT_PUBLIC_LINEA_CHAIN_ID=59144

# Frontend contract deployment settings
# Replace this before production; placeholder values fail the mainnet runtime guard.
# Mainnet guard rejects missing, invalid, or zero public contract/token/admin addresses.
# NEXT_PUBLIC_PRIVY_APP_ID=your-privy-app-id
# NEXT_PUBLIC_CONTRACT_ADDRESS=0x5e40c6e31642ebe8670658fe84c660bd2a0f820f
# NEXT_PUBLIC_LINEA_TOKEN_ADDRESS=0xYourLineaTokenAddress
# NEXT_PUBLIC_CONTRACT_DEPLOY_BLOCK=31035418
# NEXT_PUBLIC_LINEA_RPCS=https://rpc.linea.build,https://rpc.provider.your-domain.com/path
# NEXT_PUBLIC_CONTRACT_HAS_TOKEN_GETTER=1
# NEXT_PUBLIC_CONTRACT_HAS_REBATE_API=1
# NEXT_PUBLIC_CONTRACT_REQUIRES_EPOCH_BOUND_BETS=1
# Required only by the fail-closed fresh-deployment verifier.
# V10_EXPECTED_TOKEN_ADDRESS=0xYourExpectedLineaTokenAddress
# V10_EXPECTED_INITIAL_OWNER=0xYourExpectedOwnerAddress
# V10_EXPECTED_INITIAL_FEE_RECIPIENT=0xYourExpectedFeeRecipientAddress
# V10_DEPLOY_TX_HASH=0xYourDeploymentTransactionHash
# Optional post-deploy planner overrides. Update only after an intentional reviewed governance change.
# V10_EXPECTED_CURRENT_OWNER=0xYourExpectedCurrentOwnerAddress
# V10_EXPECTED_CURRENT_FEE_RECIPIENT=0xYourExpectedCurrentFeeRecipientAddress
# V10_EXPECTED_CURRENT_EPOCH_DURATION=60
# NEXT_PUBLIC_MIN_SAFETY_POOL_CLAIM_LINEA=100
# Optional read-only gas estimator diagnostics. Keep OFF unless collecting
# redacted wallet/keeper estimate comparison evidence.
# NEXT_PUBLIC_LINEA_ESTIMATE_GAS_SHADOW=0
# LINEA_ESTIMATE_GAS_SHADOW=0

# Required in production if chat auth is enabled.
# CHAT_AUTH_SECRET=replace-with-a-long-random-secret
#
# Optional private diagnostic secret for full /api/health/data-sync payloads.
# HEALTH_DIAGNOSTICS_SECRET=replace-with-a-long-random-secret
# RUNTIME_MONITOR_BASE_URL=http://localhost:3000
# RUNTIME_MONITOR_ALLOW_LOCAL=1
# RUNTIME_MONITOR_ALLOW_NO_ALERTS=1
# RUNTIME_MONITOR_INTERVAL_MS=30000
# RUNTIME_MONITOR_STUCK_GRACE_MS=120000
# RUNTIME_MONITOR_MAX_LIVE_STATE_AGE_MS=120000
# Required when LORE_PREMAINNET_RUNTIME_STRICT=1 or NODE_ENV=production.
# RUNTIME_MONITOR_BACKUP_DIR=/var/lib/lore/backups
# RUNTIME_MONITOR_BACKUP_MAX_AGE_MS=129600000
# Optional Resend email alerts for strict pre-mainnet runtime monitoring.
# Verify the sender domain in Resend before using this as evidence.
# RESEND_API_KEY=re_xxxxxxxxx
# RUNTIME_MONITOR_EMAIL_FROM=LORE <alerts@playlore.xyz>
# RUNTIME_MONITOR_EMAIL_TO=playlore88@gmail.com

# Optional local performance guard budgets for npm.cmd run baseline:bundle:summary.
# Defaults are conservative caps above the current production bundle baseline.
# BUNDLE_BASELINE_MAX_FILES=300
# BUNDLE_BASELINE_MAX_TOTAL_BYTES=10500000
# BUNDLE_BASELINE_MAX_JS_BYTES=8800000
# BUNDLE_BASELINE_MAX_SINGLE_JS_BYTES=1250000
# BUNDLE_BASELINE_MAX_CSS_BYTES=400000
# BUNDLE_BASELINE_MAX_WASM_BYTES=1500000

# Optional Telegram alerts for keeper/supervisor/runtime monitor (server-side only)
# ALERT_TELEGRAM_BOT_TOKEN=123456789:REPLACE_WITH_BOT_TOKEN
# ALERT_TELEGRAM_CHAT_ID=-1001234567890
# ALERT_TELEGRAM_THREAD_ID=
# ALERT_PREFIX=LORE Keeper
# ALERT_COOLDOWN_MS=3000000

# Optional Sentry observability.
# NEXT_PUBLIC_SENTRY_DSN=https://public-key@o000000.ingest.sentry.io/0000000
# SENTRY_DSN=https://public-key@o000000.ingest.sentry.io/0000000
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=local
# SENTRY_ENVIRONMENT=local
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0
# SENTRY_TRACES_SAMPLE_RATE=0
# NEXT_PUBLIC_SENTRY_RELEASE=
# SENTRY_RELEASE=
