# Required for the keeper bot (bot.ts)
KEEPER_PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# Privy App ID.
# Optional for local/testnet flows; required for mainnet/prod.
# NEXT_PUBLIC_PRIVY_APP_ID=cmlqkgtmg00og0cjueu4mxmn9

# Private server settings only:
# Local SQLite database file path.
# Defaults to data/lore.sqlite if omitted.
# LORE_DB_PATH=/var/lib/lore/lore.sqlite
# LORE_BACKUP_DIR=/var/lib/lore/backups
# LORE_BACKUP_CRON=0 3 * * *
# LORE_BACKUP_RETENTION_DAYS=14
# Destructive cleanup for non-current contract-scoped indexed data. Keep off unless you have a DB backup.
# LORE_ALLOW_CONTRACT_SCOPE_PURGE=0
#
# Optional private RPC key/provider endpoint
# KEEPER_RPC_URL=https://your-private-rpc.example
# Required on mainnet web hosts behind a trusted proxy so per-IP rate limits do not collapse to weak browser fingerprints.
# Only enable when your proxy strips spoofed cf-connecting-ip/x-real-ip/x-forwarded-for headers.
# The proxy must overwrite x-lore-proxy-secret; never expose this secret to browser code.
# TRUST_PROXY_HEADERS=0
# TRUST_PROXY_SECRET=replace-with-at-least-32-random-characters
# Local/CI production smoke only. Deployed testnet, staging, and mainnet hosts must keep this disabled.
# ALLOW_WEAK_RATE_LIMIT_IDENTITY=0
# WEB_REPLICA_COUNT=1
# For multiple web replicas, configure a shared Upstash-compatible Redis REST store and fail closed.
# UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
# UPSTASH_REDIS_REST_TOKEN=replace-with-server-only-standard-token
# RATE_LIMIT_EXTERNAL_FAIL_CLOSED=1
# BOOTSTRAP_KEEPER_PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE
# BOOTSTRAP_RESOLVE_SECRET=replace-with-a-long-random-secret
# Local dev only: allow /api/bootstrap-resolve without BOOTSTRAP_RESOLVE_SECRET when a keeper key is configured.
# BOOTSTRAP_RESOLVE_ALLOW_LOCAL_DEV_WITHOUT_SECRET=0
# LAST_BET_GRACE_SECONDS=2  # matches V9 contract
# PENDING_RESOLVE_STALE_MS=45000
# FORCE_REPLACE_PENDING_NONCE_GAP=6
#
# Network selection:
# Keep omitted for Sepolia dev, set BOTH vars for mainnet/prod.
# LINEA_NETWORK=mainnet
# NEXT_PUBLIC_LINEA_NETWORK=mainnet
#
# Contract deployment settings:
# Set BOTH frontend and server contract address vars when you deploy a new contract.
# V9 exposes both token() and rebate APIs; keep these enabled unless you are debugging a bad deployment.
# KEEPER_CONTRACT_ADDRESS=0x235ba811b69f4e449c11ae1264a611e67386ee4d
# NEXT_PUBLIC_CONTRACT_ADDRESS=0x235ba811b69f4e449c11ae1264a611e67386ee4d
# NEXT_PUBLIC_LINEA_TOKEN_ADDRESS=0xYourLineaTokenAddress
# INDEXER_START_BLOCK=30804467
# NEXT_PUBLIC_CONTRACT_DEPLOY_BLOCK=30804467
# INDEXER_WATCH_FAILURE_LIMIT=5
# NEXT_PUBLIC_LINEA_RPCS=https://rpc.linea.build,https://your-backup-rpc.example
# NEXT_PUBLIC_CONTRACT_HAS_TOKEN_GETTER=1
# NEXT_PUBLIC_CONTRACT_HAS_REBATE_API=1
# NEXT_PUBLIC_MIN_SAFETY_POOL_CLAIM_LINEA=100
#
# Optional private app URL override
# NEXT_PUBLIC_SITE_URL=https://playlore.xyz
#
# Required in production if chat auth is enabled.
# CHAT_AUTH_SECRET=replace-with-a-long-random-secret
#
# Optional private diagnostic secret for full /api/health/data-sync payloads.
# HEALTH_DIAGNOSTICS_SECRET=replace-with-a-long-random-secret
# DATA_SYNC_LAG_WARN_BLOCKS=800
# PROD_HEALTH_BASE_URL=https://playlore.xyz
# PROD_HEALTH_TIMEOUT_MS=15000
# PROD_HEALTH_ALLOW_DEGRADED=0
# RUNTIME_MONITOR_BASE_URL=https://playlore.xyz
# RUNTIME_MONITOR_INTERVAL_MS=30000
# RUNTIME_MONITOR_TIMEOUT_MS=15000
# RUNTIME_MONITOR_STUCK_GRACE_MS=120000
# RUNTIME_MONITOR_MAX_LIVE_STATE_AGE_MS=120000
# Optional soak alerts. Leave unset to observe without enforcing a threshold.
# RUNTIME_MONITOR_MAX_RSS_BYTES=1073741824
# RUNTIME_MONITOR_MAX_WAL_BYTES=536870912
# Defaults to 1 GiB; alert before SQLite, logs, or npm hit ENOSPC.
# RUNTIME_MONITOR_MIN_DISK_FREE_BYTES=1073741824
# Testnet soak also fails before starting when its artifact volume is below 1 GiB.
# SOAK_MIN_DISK_FREE_BYTES=1073741824
# Optional bounded-tail detection for a live canary JSONL file.
# RUNTIME_MONITOR_CANARY_LOG_PATH=/var/lib/lore/live-canary.jsonl
# RUNTIME_MONITOR_CANARY_REVERT_WINDOW_MS=300000
# RUNTIME_MONITOR_CANARY_REVERT_THRESHOLD=3
# Alert when an active canary log stops receiving events; completed summary logs are exempt.
# RUNTIME_MONITOR_CANARY_MAX_STALE_MS=300000
# PM2 runs `npm run audit:chain-indexer` every 30 minutes by default; keep output on persistent storage.
# CHAIN_INDEXER_AUDIT_CRON=*/30 * * * *
# CHAIN_INDEXER_AUDIT_EPOCHS=50
# CHAIN_INDEXER_AUDIT_OUT=/var/lib/lore/chain-indexer-audit.json
# RUNTIME_MONITOR_CHAIN_AUDIT_PATH=/var/lib/lore/chain-indexer-audit.json
# RUNTIME_MONITOR_CHAIN_AUDIT_MAX_AGE_MS=3600000
# RUNTIME_MONITOR_BACKUP_DIR=/var/lib/lore/backups
# RUNTIME_MONITOR_BACKUP_MAX_AGE_MS=129600000
# RUNTIME_MONITOR_ALLOW_NO_ALERTS=0
# RUNTIME_MONITOR_STATE_PATH=data/runtime-monitor-state.json
#
# Optional maintenance toggle
# NEXT_PUBLIC_MAINTENANCE_MODE=0

# Optional Sentry observability.
# Public DSN enables browser error capture. Private DSN enables server/edge capture.
# Set SENTRY_AUTH_TOKEN/SENTRY_ORG/SENTRY_PROJECT only in CI when uploading sourcemaps.
# NEXT_PUBLIC_SENTRY_DSN=https://public-key@o000000.ingest.sentry.io/0000000
# SENTRY_DSN=https://public-key@o000000.ingest.sentry.io/0000000
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
# SENTRY_ENVIRONMENT=production
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0
# SENTRY_TRACES_SAMPLE_RATE=0
# NEXT_PUBLIC_SENTRY_RELEASE=
# SENTRY_RELEASE=
# SENTRY_ORG=your-org-slug
# SENTRY_PROJECT=your-project-slug
# SENTRY_AUTH_TOKEN=

# Optional gas-saving toggles (frontend):
# Keep both OFF by default to avoid extra resolve tx gas from browser users.
# NEXT_PUBLIC_ENABLE_CLIENT_AUTO_RESOLVE=0
# NEXT_PUBLIC_ENABLE_AUTO_RESOLVE_SWEEP=0

# Experimental EIP-7702 toggles.
# Keep OFF until the target network and wallet stack support it reliably.
# Mining 7702 is ignored unless NEXT_PUBLIC_EIP7702_ENABLED is also enabled.
# NEXT_PUBLIC_EIP7702_ENABLED=0
# NEXT_PUBLIC_EIP7702_MINING_ENABLED=0
# NEXT_PUBLIC_EIP7702_DELEGATE_ADDRESS=0xYourVerifiedBoundDelegate

# Optional Telegram alerts for keeper and runtime monitor (server-side only, never exposed to frontend)
# ALERT_TELEGRAM_BOT_TOKEN=123456789:REPLACE_WITH_BOT_TOKEN
# ALERT_TELEGRAM_CHAT_ID=-1001234567890
# ALERT_TELEGRAM_THREAD_ID=12345
# ALERT_PREFIX=LORE Keeper
# ALERT_COOLDOWN_MS=300000

# Optional live testnet canary failure injection.
# The synthetic transport fails before dispatch, then viem uses configured RPC fallbacks.
# LIVE_TEST_INJECT_RPC_FAILOVER=0
# Optional canary soak telemetry. Use HTTPS except for localhost; the secret is never written to canary artifacts.
# LIVE_TEST_HEALTH_BASE_URL=http://localhost:3000
# LIVE_TEST_HEALTH_SAMPLE_EVERY_ROUNDS=10
# LIVE_TEST_HEALTH_TIMEOUT_MS=10000
